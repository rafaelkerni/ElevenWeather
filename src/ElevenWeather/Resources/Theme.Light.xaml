<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WinUI 3 light theme tokens (Common_themeresources_any.xaml). -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000"/>

    <SolidColorBrush x:Key="PillRestBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="PillHoverBrush" Color="#09000000"/>
    <SolidColorBrush x:Key="PillPressedBrush" Color="#06000000"/>

    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="FlyoutCardBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="FlyoutButtonBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="FlyoutButtonHoverBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="FlyoutChevronBrush" Color="#80000000"/>

    <Color x:Key="AcrylicTintColor">#F3F3F3</Color>

</ResourceDictionary>
