<Window x:Class="ElevenWeather.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ElevenWeather.Converters"
        Title="ElevenWeather"
        Width="152" Height="48"
        Left="-10000" Top="-10000"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:IconKeyToImageSourceConverter x:Key="IconKeyConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" Cursor="Hand">
        <Border Width="136" Height="40"
                Margin="16,4,0,4"
                HorizontalAlignment="Left"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <Border x:Name="HoverLayer" Background="{DynamicResource PillHoverBrush}" Opacity="0"/>
                <Border x:Name="PressedLayer" Background="{DynamicResource PillPressedBrush}" Opacity="0"/>

                <Image Source="{Binding IconKey, Converter={StaticResource IconKeyConverter}}"
                       Width="24" Height="24"
                       Margin="3,7,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="{Binding TemperatureText}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="35,3,4,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Text="{Binding DescriptionText}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="35,19,4,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
